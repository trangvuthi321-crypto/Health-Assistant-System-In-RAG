# 复制为 .env（本目录或仓库根目录），.env 已被 .gitignore 排除，切勿提交

# ===== 模型/向量服务（兼容 OpenAI 协议，示例为 DashScope）=====
OPENAI_API_KEY=

# ===== Java <-> Python 共享口令，留空不校验 =====
SERVICE_TOKEN=

# ===== 健康数据库（只读，供报告工具查询）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=communitypension
DB_USER=root
DB_PASSWORD=

