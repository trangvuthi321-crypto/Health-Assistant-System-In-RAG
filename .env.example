# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，切勿提交

# ===== 健康助手 Agent 服务（agent-service，python-dotenv 会自动加载）=====
# 兼容 OpenAI 协议的模型/向量服务密钥（示例为 DashScope）
OPENAI_API_KEY=
# Java 与 Python 之间的共享口令，留空表示不校验
SERVICE_TOKEN=
# 健康数据库（只读，供生成老人健康报告的工具查询）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=communitypension
DB_USER=root
DB_PASSWORD=
# 可选：服务监听地址/端口
# API_HOST=127.0.0.1
# API_PORT=8000

# ===== 后端（backend，SpringBoot 读取的是系统环境变量）=====
# 数据库连接（未设置时使用 application.yml 中的默认值）
DB_URL=jdbc:mysql://localhost:3306/communitypension?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=UTC&allowMultiQueries=true
DB_USERNAME=root
# Python 服务地址
ASSISTANT_BASE_URL=http://127.0.0.1:8000
